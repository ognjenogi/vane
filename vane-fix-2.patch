From 25094371bea83850229929af880fb84ea0ad6e56 Mon Sep 17 00:00:00 2001
From: Ognjen Nikolic <ognjennikolic203@gmail.com>
Date: Tue, 15 Sep 2026 00:40:55 +0200
Subject: [PATCH] Fix skipSearch citation contradiction + add Seznam as primary
 SearXNG engine

- Writer prompt now conditionally drops citation requirements when no search
  results exist (skipSearch=true or empty results). Prevents LLM refusal on
  simple factual questions and eliminates phantom [1][2] citations.
- SearXNG: Seznam engine added with weight 3 (verified working on Contabo IP).
  Bing/Brave/Google demoted to weight 1. Added IMDb + HackerNews as
  working domain-specific engines.
---
 searxng/settings.yml             | 33 ++++++++++++++++++++++++++------
 src/lib/agents/search/api.ts     |  3 +++
 src/lib/agents/search/index.ts   |  5 +++++
 src/lib/prompts/search/writer.ts | 32 ++++++++++++++++++++++---------
 4 files changed, 58 insertions(+), 15 deletions(-)

diff --git a/searxng/settings.yml b/searxng/settings.yml
index 5e31a0d..71034df 100644
--- a/searxng/settings.yml
+++ b/searxng/settings.yml
@@ -22,41 +22,62 @@ outgoing:
   pool_maxsize: 20
 
 engines:
+  # Primary: Engines verified working on Contabo VPS IP
+  - name: seznam
+    engine: seznam
+    categories: [general, web]
+    disabled: false
+    weight: 3
+    shortcut: sz
   - name: bing
     engine: bing
     categories: [general, web]
     disabled: false
-    weight: 2
+    weight: 1
+  # Secondary: May work intermittently, keep as fallbacks
   - name: brave
     engine: brave
     categories: [general, web]
     disabled: false
-    weight: 2
+    weight: 1
   - name: duckduckgo
     engine: duckduckgo
     categories: [general, web]
     disabled: false
-    weight: 1
+    weight: 0.5
   - name: google
     engine: google
     categories: [general, web]
     disabled: false
-    weight: 1.5
+    weight: 1
   - name: qwant
     engine: qwant
     categories: [general, web]
     disabled: false
-    weight: 1
+    weight: 0.5
   - name: yahoo
     engine: yahoo
     categories: [general, web]
     disabled: false
-    weight: 1
+    weight: 0.5
+  # Domain-specific: Always work from datacenter IPs
   - name: wikipedia
     engine: wikipedia
     categories: [general]
     disabled: false
+    weight: 1.5
+  - name: imdb
+    engine: imdb
+    categories: [general]
+    disabled: false
+    weight: 1
+    shortcut: imdb
+  - name: hackernews
+    engine: hackernews
+    categories: [general, news, it]
+    disabled: false
     weight: 1
+    shortcut: hn
   - name: arxiv
     engine: arxiv
     categories: [science, scientific publications]
